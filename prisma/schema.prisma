generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id            String   @id @default(cuid())
  userEmail     String
  projectName   String
  gscSiteUrl    String
  ga4PropertyId String
  createdAt     DateTime @default(now())
}